# Local example only: replace before deployment.
CAE_API_TOKENS={"local-test-token":"demo"}
# Absolute shared model directory on the service host.
CAE_MODEL_ROOT=/srv/cae/models
CAE_PROJECT_ROOT=workspace
CAE_OUTPUT_ROOT=workspace
CAE_DATABASE_PATH=workspace/guie.db
CAE_RUN_ROOT=workspace/runs
CAE_TASK_LOG_ROOT=static/logs
CAE_SERVICE_LOG_ROOT=workspace/logs
CAE_RUN_TIMEOUT_SECONDS=300
CAE_WORKER_POLL_SECONDS=0.2
CAE_MAX_REQUEST_BYTES=65536
# Internal test-script settings, never controlled by callers.
CAE_TEST_SLEEP_SECONDS=60
CAE_TEST_EXIT_CODE=0

# Docker Compose only. Models appear at /models inside BOTH containers.
MODEL_HOST_DIR=/srv/cae/models
