# API and Worker must read the same paths. Local Mock credentials only.
CAE_PROVIDER=mock
CAE_API_TOKENS={"local-test-token":"demo"}
CAE_DATABASE_PATH=.runtime/cae.db
CAE_ASSET_ROOT=.runtime/assets
CAE_JOB_ROOT=.runtime/jobs
CAE_MAX_FILE_BYTES=10485760
CAE_MAX_RECORDS=10000
CAE_MAX_PROCESS_NUM=8
CAE_WORKER_POLL_SECONDS=0.2
CAE_WORKER_LEASE_SECONDS=15
CAE_RUN_TIMEOUT_SECONDS=300
CAE_MOCK_DELAY_SECONDS=0.05
CAE_ENABLE_LEGACY_API=false
CAE_ALLOW_SERVER_PATHS=false
