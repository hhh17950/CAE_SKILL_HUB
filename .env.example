# Local example only: replace before deployment.
WORKSPACE=/opt/cae_agent
SSTA_CAE_PATH=/home/vinci/ssta-case-26.8.24
CAE_WORKSPACE_ROOT=workspace
CAE_GUIERUNNER_PATH=/opt/guierunner
CAE_DATABASE_PATH=workspace/guie.db
CAE_SERVICE_LOG_ROOT=workspace/logs
CAE_RUN_TIMEOUT_SECONDS=300
CAE_WORKER_POLL_SECONDS=0.2
CAE_MAX_REQUEST_BYTES=104857600
CAE_MAX_MODEL_BYTES=52428800
CAE_MCP_ENABLED=true
# 对外公布地址：必须填调用方（智能体）能访问到的地址，不能用 0.0.0.0 / 127.0.0.1，
# 否则 get_run_result 返回的云图 image_url 在其他机器上打不开。内网部署填服务器 IP。
CAE_PUBLIC_BASE_URL=http://192.168.16.128:8000
CAE_TEST_SLEEP_SECONDS=60
CAE_TEST_EXIT_CODE=0
