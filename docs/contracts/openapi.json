{
  "components": {
    "schemas": {
      "ErrorItem": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "title": "ErrorItem",
        "type": "object"
      },
      "GuieRunRequest": {
        "additionalProperties": false,
        "properties": {
          "density": {
            "exclusiveMinimum": 0.0,
            "title": "Density",
            "type": "integer"
          },
          "model_path": {
            "minLength": 1,
            "title": "Model Path",
            "type": "string"
          },
          "number_of_roots": {
            "minimum": 1.0,
            "title": "Number Of Roots",
            "type": "integer"
          },
          "poisson_ratio": {
            "exclusiveMaximum": 0.5,
            "exclusiveMinimum": -1.0,
            "title": "Poisson Ratio",
            "type": "number"
          },
          "young_modulus": {
            "exclusiveMinimum": 0.0,
            "title": "Young Modulus",
            "type": "number"
          }
        },
        "required": [
          "model_path",
          "young_modulus",
          "poisson_ratio",
          "density",
          "number_of_roots"
        ],
        "title": "GuieRunRequest",
        "type": "object"
      },
      "GuieRunView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "log_urls": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Log Urls",
            "type": "object"
          },
          "result_url": {
            "title": "Result Url",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "timed_out",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status",
          "created_at",
          "status_url",
          "result_url",
          "log_urls"
        ],
        "title": "GuieRunView",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "instance",
          "code",
          "detail",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "固定 guie2 测试脚本的异步任务服务。以退出码判断脚本运行状态；当前不启动真实 GUI、不计算物理结果。",
    "title": "CAE SkillHub — guie2 Script Service",
    "version": "0.3.0-test"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/guie-runs": {
      "post": {
        "operationId": "submit_guie_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuieRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuieRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Submit Guie Run",
        "tags": [
          "guie-runs"
        ]
      }
    },
